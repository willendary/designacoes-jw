rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function accessPath() {
      return /databases/$(database)/documents/workspaces/designacoes-jw/settings/access;
    }

    function invitationPath(invitationId) {
      return /databases/$(database)/documents/workspaces/designacoes-jw/invitations/$(invitationId);
    }

    // Uma conta não obtém acesso só por estar autenticada.
    // Somente convites pendentes para e-mail verificado podem conceder perfil.
    function validInvitation(invitationId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && invitationId is string
        && exists(invitationPath(invitationId))
        && get(invitationPath(invitationId)).data.status == 'pending'
        && get(invitationPath(invitationId)).data.email == request.auth.token.email.lower();
    }

    function invitedProfile(invitationId) {
      return validInvitation(invitationId)
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == 'custom'
        && request.resource.data.active == true
        && request.resource.data.invitationId == invitationId
        && request.resource.data.permissions is list
        && request.resource.data.permissions.size() == get(invitationPath(invitationId)).data.permissions.size()
        && request.resource.data.permissions.hasAll(get(invitationPath(invitationId)).data.permissions);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function profile() {
      return get(userPath(request.auth.uid));
    }

    function activeUser() {
      return isAdmin() || (hasProfile() && profile().data.active == true);
    }

    function isAdmin() {
      return signedIn() && (
        (exists(userPath(request.auth.uid)) && profile().data.role == 'admin') ||
        (exists(accessPath()) && get(accessPath()).data.bootstrapUid == request.auth.uid)
      );
    }

    function hasPermission(permission) {
      return activeUser() && (isAdmin() || permission in profile().data.permissions);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && invitedProfile(request.resource.data.invitationId)
      );

      // O usuário pode corrigir dados próprios, nunca elevar permissões.
      // Convite válido pode transformar perfil preexistente não administrador.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && (
          (
            request.resource.data.role == resource.data.role
            && request.resource.data.permissions == resource.data.permissions
            && request.resource.data.active == resource.data.active
            && request.resource.data.invitationId == resource.data.invitationId
            && request.resource.data.email == resource.data.email
          ) || (
            resource.data.role != 'admin'
            && invitedProfile(request.resource.data.invitationId)
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /workspaces/designacoes-jw/settings/access {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /workspaces/designacoes-jw/settings/main {
      allow read: if activeUser();
      allow write: if hasPermission('manage_settings');
    }

    match /workspaces/designacoes-jw/brothers/{brotherId} {
      allow read: if hasPermission('view_assignments');
      // Registrar ausencia e parte de gerar designacoes, nao de gerenciar
      // irmaos: a tela "Quem falta?" oferece para quem tem generate_assignments.
      // A regra exige que ESSA seja a unica mudanca, para o atalho nao virar
      // escalonamento de privilegio via um save do documento inteiro.
      allow write: if hasPermission('manage_brothers') || (
        hasPermission('generate_assignments') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unavailabilities'])
      );
    }

    match /workspaces/designacoes-jw/privileges/{privilegeId} {
      allow read: if hasPermission('view_assignments');
      allow write: if hasPermission('manage_privileges');
    }

    match /workspaces/designacoes-jw/meetings/{meetingId} {
      allow read: if hasPermission('view_assignments');
      allow write: if hasPermission('generate_assignments');
    }

    match /workspaces/designacoes-jw/publicTalks/{talkId} {
      allow read: if hasPermission('view_assignments');
      allow write: if hasPermission('manage_settings') || hasPermission('generate_assignments') || isAdmin();
    }

    match /workspaces/designacoes-jw/fieldServiceGroups/{groupId} {
      allow read: if hasPermission('view_assignments');
      allow write: if hasPermission('manage_settings') || hasPermission('manage_brothers') || isAdmin();
    }

    match /workspaces/designacoes-jw/cleaningSchedules/{scheduleId} {
      allow read: if hasPermission('view_assignments');
      allow write: if hasPermission('manage_settings') || hasPermission('generate_assignments') || isAdmin();
    }

    match /workspaces/designacoes-jw/invitations/{invitationId} {
      allow get: if isAdmin() || (
        signedIn() && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email.lower()
      );
      allow list: if isAdmin();

      allow create, delete: if hasPermission('manage_users');

      // Quem aceita só pode marcar como aceito o próprio convite.
      // Campos de e-mail, permissões e autoria são imutáveis neste fluxo.
      allow update: if isAdmin() || (
        signedIn() && request.auth.token.email_verified == true
        && resource.data.status == 'pending'
        && resource.data.email == request.auth.token.email.lower()
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'custom'
        && get(userPath(request.auth.uid)).data.invitationId == invitationId
      );
    }
  }
}
